<?xml version="1.0" encoding="utf-8"?>
<!-- The photo screensaver's shade: darker at the top and the bottom, where the clock and the name sit. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66000000" android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#73000000" android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
