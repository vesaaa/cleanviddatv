<?xml version="1.0" encoding="utf-8"?>
<!-- FilePickerActivity: the folder or file an app asked for, chosen with the remote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="vertical"
    android:paddingStart="72dp"
    android:paddingEnd="72dp"
    android:paddingTop="38dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/pickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/pickerPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="start"
        android:textColor="#99FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/pickerUseFolder"
        style="@style/SettingsRow"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_file_check_folder"
        android:drawablePadding="16dp"
        android:text="@string/files_use_folder"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#99FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />
</LinearLayout>
