<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/wallTile"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#FF242B34"
        android:foreground="@drawable/wallpaper_tile_fg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/wallThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/wallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/wallBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/wallpaper_badge_bg"
            android:text="@string/wallpaper_in_use"
            android:textColor="#FF101419"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wallLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/wallpaper_label_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>
